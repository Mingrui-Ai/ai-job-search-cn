{
  "version": 1,
  "direction": "default",
  "revision": 1,
  "label": "通用",
  "followup": {
    "max_chars": 300,
    "slots": [
      {"slot": "context", "required": true, "hint": "说明此前申请的岗位；引用 job 和当前有效 submitted 事件，不知道日期就不写日期"},
      {"slot": "progress", "required": false, "hint": "只引用本次投递已保存且有效的进展；用户备注不等于招聘方回复"},
      {"slot": "request", "required": true, "hint": "简短询问进展、下一步或是否需补材料，表示感谢；不把本地提醒日写成对方承诺"}
    ],
    "examples": ["您好，我此前提交了{job.title}岗位的申请。想请问目前的招聘进展，是否还有需要我补充的材料？谢谢。"]
  },
  "greeting": {
    "max_chars": 150,
    "slots": [
      {
        "slot": "opening",
        "required": true,
        "hint": "称呼加一句自我介绍：学校、专业、应聘的岗位（用占位符 {edu-1.school}、{job.title} 等，不手写）"
      },
      {
        "slot": "evidence",
        "required": true,
        "max": 2,
        "prefer": [
          "internship",
          "work",
          "project",
          "campus",
          "research",
          "competition"
        ],
        "hint": "一两条和 JD 最相关的经历，写清做了什么、结果如何（数字照档案写）"
      },
      {
        "slot": "availability",
        "required": false,
        "hint": "实习岗写到岗时间、每周天数、实习时长，必须引用 availability"
      },
      {
        "slot": "closing",
        "required": true,
        "hint": "一句话收尾，例如希望进一步沟通、可以发简历"
      }
    ],
    "examples": [
      "您好，我是{edu-1.school}{edu-1.major}专业的学生，想应聘贵司的{job.title}岗位。"
    ]
  },
  "email": {
    "max_chars": 600,
    "subject_max_chars": 40,
    "subject_hint": "应聘岗位 + 姓名 + 学校，例如 应聘{job.title}-{contact.name}-{edu-1.school}",
    "slots": [
      {
        "slot": "salutation",
        "required": true,
        "hint": "不知道收件人时写 您好；知道再写具体称呼"
      },
      {
        "slot": "opening",
        "required": true,
        "hint": "我是谁、从哪看到岗位、应聘什么岗位"
      },
      {
        "slot": "evidence",
        "required": true,
        "max": 3,
        "prefer": [
          "internship",
          "work",
          "project",
          "campus",
          "research",
          "competition"
        ],
        "hint": "一两条和 JD 最相关的经历，写清做了什么、结果如何（数字照档案写）"
      },
      {
        "slot": "fit",
        "required": false,
        "hint": "为什么想做这个岗位、这家公司（只写档案或 JD 里有依据的）；说明能按 JD 的要求到岗"
      },
      {
        "slot": "availability",
        "required": false,
        "hint": "到岗时间、每周天数、实习时长，必须引用 availability"
      },
      {
        "slot": "closing",
        "required": true,
        "hint": "说明附件是简历，期待回复"
      },
      {
        "slot": "signature",
        "required": true,
        "hint": "姓名和联系方式，用 {contact.name}、{contact.phone}、{contact.email}"
      }
    ],
    "examples": [
      "您好！我是{edu-1.school}{edu-1.major}专业的{contact.name}，应聘贵司的{job.title}岗位，简历见附件。"
    ]
  },
  "referral": {
    "max_chars": 300,
    "slots": [
      {
        "slot": "opening",
        "required": true,
        "hint": "称呼加寒暄，说明自己是谁、怎么认识的（不要编造关系）"
      },
      {
        "slot": "ask",
        "required": true,
        "hint": "想请对方内推哪个岗位（{job.company} 的 {job.title}）"
      },
      {
        "slot": "evidence",
        "required": true,
        "max": 2,
        "prefer": [
          "internship",
          "work",
          "project",
          "campus",
          "research",
          "competition"
        ],
        "hint": "一两条最相关的经历，让对方好向团队介绍"
      },
      {
        "slot": "closing",
        "required": true,
        "hint": "说明会发简历、不方便也没关系，表示感谢"
      }
    ],
    "examples": [
      "学姐好，我想请您帮忙内推{job.company}的{job.title}岗位。"
    ]
  }
}
